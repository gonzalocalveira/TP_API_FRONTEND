# Copiá este archivo como .env.local para cambiar la configuración.

# true (por defecto): la app usa datos simulados (src/services/mockApi.js).
# false: usa la API real del back-end (src/services/httpApi.js).
VITE_USE_MOCKS=true

# URL del back-end (Spring Boot). Solo se usa con VITE_USE_MOCKS=false.
VITE_API_URL=http://localhost:8080

# true: las consultas simuladas fallan con error 500, para mostrar el estado de error en la demo.
# También se puede activar sin tocar este archivo agregando ?error=1 a la URL (?error=0 lo apaga).
VITE_SIMULAR_ERRORES=false
